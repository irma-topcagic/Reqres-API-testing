    {
      "name": "List Users",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200\", function () {\r",
              "    pm.response.to.have.status(200);\r",
              "});\r",
              "\r",
              "var jsonData = pm.response.json();\r",
              "\r",
              "pm.test(\"Correct JSON data\", function () {\r",
              "    pm.expect(jsonData.page).to.eql(2);\r",
              "    pm.expect(jsonData.per_page).to.eql(6);\r",
              "    pm.expect(jsonData.data[0].id).to.eql(7);\r",
              "});\r",
              "\r",
              "pm.test(\"Data contains user with first_name George\", function () {\r",
              "    var found = false;\r",
              "\r",
              "    for (var i = 0; i < jsonData.data.length; i++) {\r",
              "        if (jsonData.data[i].first_name === \"George\") {\r",
              "            found = true;\r",
              "            break;\r",
              "        }\r",
              "    }\r",
              "\r",
              "    pm.expect(found).to.be.true;\r",
              "});\r",
              "\r",
              ""
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],

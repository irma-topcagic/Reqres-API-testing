    {
      "name": "List All Resources",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"Content-Type is JSON\", function () {",
              "    pm.expect(pm.response.headers.get(\"Content-Type\"), \"Content-Type header\").to.match(/^application\\/json\\b/i);",
              "});",
              "var responseJson;",
              "",
              "let resourceName = pm.response.json().data[1].name;",
              "pm.environment.set(\"resourceName\",resourceName);",
              "",
              "",
              "pm.test(\"Response body is valid JSON with an object structure\", function () {",
              "    pm.expect(function () {",
              "        responseJson = pm.response.json();",
              "    }, \"response body should parse as JSON\").to.not.throw();",
              "",
              "    pm.expect(responseJson, \"response body\").to.be.an(\"object\").and.not.be.null;",
              "    pm.expect(responseJson, \"response body\").to.not.be.an(\"array\");",
              "});",
              "",
              "pm.test(\"Response contains required numeric pagination fields\", function () {",
              "    pm.expect(responseJson, \"parsed response body\").to.be.an(\"object\").and.not.be.null;",
              "",
              "    [\"page\", \"per_page\", \"total\", \"total_pages\"].forEach(function (field) {",
              "        pm.expect(responseJson, \"response body\").to.have.property(field);",
              "        pm.expect(responseJson[field], field).to.be.a(\"number\").and.to.satisfy(Number.isFinite);",
              "    });",
              "});",
              "",
              "pm.test(\"Data is a non-empty array\", function () {",
              "    pm.expect(responseJson, \"parsed response body\").to.be.an(\"object\").and.not.be.null;",
              "    pm.expect(responseJson, \"response body\").to.have.property(\"data\");",
              "    pm.expect(responseJson.data, \"data\").to.be.an(\"array\").that.is.not.empty;",
              "});",
              "",
              "pm.test(\"Each resource has valid required fields\", function () {",
              "    pm.expect(responseJson, \"parsed response body\").to.be.an(\"object\").and.not.be.null;",
              "    pm.expect(responseJson.data, \"data\").to.be.an(\"array\").that.is.not.empty;",
              "",
              "    responseJson.data.forEach(function (resource, index) {",
              "        const label = \"data[\" + index + \"]\";",
              "",
              "        pm.expect(resource, label).to.be.an(\"object\").and.not.be.null;",
              "",
              "        pm.expect(resource, label).to.have.property(\"id\");",
              "        pm.expect(resource.id, label + \".id\").to.be.a(\"number\").and.to.satisfy(Number.isFinite);",
              "",
              "        pm.expect(resource, label).to.have.property(\"year\");",
              "        pm.expect(resource.year, label + \".year\").to.be.a(\"number\").and.to.satisfy(Number.isFinite);",
              "",
              "        pm.expect(resource, label).to.have.property(\"name\");",
              "        pm.expect(resource.name, label + \".name\").to.be.a(\"string\").and.to.match(/\\S/);",
              "",
              "        pm.expect(resource, label).to.have.property(\"color\");",
              "        pm.expect(resource.color, label + \".color\").to.be.a(\"string\").and.to.match(/^#[0-9A-Fa-f]{6}$/);",
              "",
              "        pm.expect(resource, label).to.have.property(\"pantone_value\");",
              "        pm.expect(resource.pantone_value, label + \".pantone_value\").to.be.a(\"string\").and.to.match(/\\S/);",
              "    });",
              "});"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
